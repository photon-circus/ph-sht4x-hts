(
    expected_version: "0.1.0-incubating.1",
    lifecycle_packages: [
        (
            manifest: "crates/sht4x/Cargo.toml",
            require_unpublished: true,
        ),
        (
            manifest: "crates/sht4x-model/Cargo.toml",
            require_unpublished: true,
        ),
        (
            manifest: "crates/sht4x-conformance/Cargo.toml",
            require_unpublished: true,
        ),
    ],
    driver: (
        package: "ph-sht4x-hts",
        manifest: "crates/sht4x/Cargo.toml",
    ),
    supported_targets: [
        "thumbv6m-none-eabi",
        "thumbv7m-none-eabi",
        "thumbv7em-none-eabihf",
        "thumbv8m.main-none-eabihf",
        "riscv32imac-unknown-none-elf",
    ],
    coverage: (
        unit_packages: [
            "ph-sht4x-hts",
            "ph-sht4x-hts-model",
        ],
        conformance: (
            package: "ph-sht4x-hts-conformance",
            test: "conformance",
        ),
        infrastructure_packages: ["xtask"],
        ignored_filename_regex: "tests\\.rs$",
        output_directory: "target/coverage",
    ),
)
